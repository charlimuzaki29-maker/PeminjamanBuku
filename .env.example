# ==============================================================================
# KONFIGURASI ENVIRONMENT APLIKASI PERPUSTAKAAN DIGITAL (LARAVEL)
# ==============================================================================
# File ini merupakan template konfigurasi sistem.
# Salin file ini menjadi `.env` lalu jalankan `php artisan key:generate`.
# ==============================================================================

# 1. Konfigurasi Dasar Aplikasi
APP_NAME="Perpustakaan Digital"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

# 2. Konfigurasi Logging (Pencatatan Log Aktivitas/Error)
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# 3. Konfigurasi Basis Data (Database)
# Default menggunakan SQLite (`database/database.sqlite`), sangat praktis tanpa perlu instal MySQL server.
# Jika ingin beralih ke MySQL, ubah DB_CONNECTION=mysql dan sesuaikan baris di bawahnya.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=peminjamanperpus
# DB_USERNAME=root
# DB_PASSWORD=

# 4. Konfigurasi Sesi Pengguna (Session)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# 5. Konfigurasi Cache & Antrian (Queue)
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# 6. Konfigurasi Pengiriman Email
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="admin@perpus.com"
MAIL_FROM_NAME="${APP_NAME}"

# 7. Konfigurasi Frontend Vite
VITE_APP_NAME="${APP_NAME}"
